# Copy to .env and fill in. Never commit .env with real secrets.
# Testnet only - never paste a mainnet secret here.

# Horizon endpoint (testnet default)
HORIZON_URL=https://horizon-testnet.stellar.org

# Network passphrase: "Test SDF Network ; September 2015" for testnet
